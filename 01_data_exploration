**Exploratory Data Analysis**

# Separate features (X) and target (y)
X = df.drop(columns=['name', 'status']) # 'name' is just an identifier, 'status' is the target
y = df['status']
print(X)

# Calculating the correlation matrix to understand the relationships between features
import seaborn as sns
import matplotlib.pyplot as plt

correlation_matrix = X.corr()
plt.figure(figsize=(15,10))
sns.heatmap(correlation_matrix, annot=True, cmap="coolwarm", fmt=".2f")
plt.title('Correlation Matrix of Features')
plt.show(block=True)

#Analyzing the distribution of the target variable (status) using a histogram

ax = sns.countplot(x='Status', data=df) # Plot count
total = len(df) # Calculate proportions

for p in ax.patches: # Add percentage labels

    height = p.get_height()

    percentage = 100 * height / total

    ax.annotate(f'{percentage:.1f}%',

                (p.get_x() + p.get_width() / 2., height),

                ha='center',

                va='bottom',

                fontsize=12)
plt.title('Distribution of Status')

plt.xlabel('Status')

plt.ylabel('Count')

plt.show(block=True)

#Visualizing the distribution of each feature to understand their distributions
features = X.columns
num_features = len(features)
num_rows = (num_features // 3) + (num_features % 3 > 0)  # Calculate the number of rows needed

plt.figure(figsize=(15, 5 * num_rows))

for i, feature in enumerate(features):
    plt.subplot(num_rows, 3, i+1)
    sns.histplot(X[feature], kde=True, color='black', bins=30)
    plt.title(f'Distribution of {feature}')

plt.tight_layout()
plt.show(block=True)
